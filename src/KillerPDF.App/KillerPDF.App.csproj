<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>KillerPDF</AssemblyName>
    <RootNamespace>KillerPDF.App</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Resources\kp-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0-fork.0</Version>

    <!-- Single-file publish, no extra DLLs on disk -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KillerPDF.Core\KillerPDF.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same PDF stack as upstream. Versions bumped to .NET 8-compatible releases. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\kp-icon.ico" />
  </ItemGroup>

  <!-- GPL3 source bundle: produces KillerPDF-<Version>-src.zip in publish folder. -->
  <Target Name="BundleSource" AfterTargets="Publish">
    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\bundle-source.ps1&quot; -ProjectDir &quot;$(MSBuildThisFileDirectory.TrimEnd('\'))&quot; -Version &quot;$(Version)&quot; -AppName &quot;$(AssemblyName)&quot; -PublishDir &quot;$(PublishDir.TrimEnd('\'))&quot;"
      ContinueOnError="false"
      Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\bundle-source.ps1')" />
  </Target>

</Project>
