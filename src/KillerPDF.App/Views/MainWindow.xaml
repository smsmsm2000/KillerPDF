<Window x:Class="KillerPDF.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1100" Height="800"
        WindowStartupLocation="CenterScreen">

    <!--
        PORT: this is a stub. Upstream MainWindow.xaml (~615 lines) defines the
        toolbar, the page-thumbnail rail, the central PDF surface, and the
        signature/edit panels. Copy that XAML in, then:
          - replace Click="…" handlers with Command="{Binding XxxCommand}"
          - replace direct field access (this.SomeControl.X) with bindings
          - move data-shaped state (current page, zoom, dirty flag) onto
            MainViewModel / DocumentViewModel where it already lives.
    -->

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…"        Command="{Binding OpenCommand}"          InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save"         Command="{Binding SaveCommand}"          InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As…"     Command="{Binding SaveAsCommand}"        InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="Save _Flattened…" Command="{Binding SaveFlattenedCommand}" />
                <Separator />
                <MenuItem Header="_Print…"       Command="{Binding PrintCommand}"         InputGestureText="Ctrl+P" />
                <Separator />
                <MenuItem Header="_Close"        Command="{Binding CloseCommand}"         InputGestureText="Ctrl+W" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusText}" />
        </StatusBar>

        <Grid>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="#888"
                       Text="Open a PDF to get started (Ctrl+O)." />
            <!-- PORT: page rail + page surface go here. Bind to Current.Pages and Current.CurrentPage. -->
        </Grid>
    </DockPanel>
</Window>
